{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:lang(es|en)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(es|en)/",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:page(download|termos-de-uso|politica-de-privacidade|blog)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/es/:page(descargar|terminos-de-uso|politica-de-privacidad)",
      "destination": "/es/:page/index.html"
    },
    {
      "source": "/en/:page(download|terms-of-use|privacy-policy)",
      "destination": "/en/:page/index.html"
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/es/(.*)",
      "destination": "/es/index.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/prints/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ajuda-videos.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
